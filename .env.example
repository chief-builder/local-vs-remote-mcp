# Copy to .env (gitignored). See the Configuration table in README.md.

# User or org that owns the throwaway lvrmcp-* sandbox repos.
GITHUB_SANDBOX_OWNER=

# Harness-held controller credential (fine-grained PAT). Never passed to agent children.
GITHUB_CONTROLLER_TOKEN=

# Agent credential (fine-grained PAT) given to both MCP arms as GITHUB_PERSONAL_ACCESS_TOKEN.
GITHUB_AGENT_TOKEN=

# Optional: used instead of GITHUB_AGENT_TOKEN when that is unset.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Toolsets for the local server during probe:tools (trials always use all).
GITHUB_TOOLSETS=all

# Optional: Claude Code tool-discovery mode (unset = all MCP tools deferred). Recorded per trial.
# ENABLE_TOOL_SEARCH=false
