# Sandbox owner used by later trial provisioning.
GITHUB_SANDBOX_OWNER=

# Harness-held controller credential. Must never be inherited by agent children.
GITHUB_CONTROLLER_TOKEN=

# Agent credential for local stdio smoke tests, if bypassing OAuth with a PAT.
GITHUB_AGENT_TOKEN=

# Optional direct bearer for the remote streamable HTTP probe.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Keep the spike broad until the local/remote overlap is measured.
GITHUB_TOOLSETS=all

