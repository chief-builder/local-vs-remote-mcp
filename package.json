{
  "name": "local-vs-remote-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Research harness comparing local stdio MCP and remote streamable HTTP MCP transports.",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"harness/src/**\" --test-coverage-include=\"experiments/**\" \"test/**/*.test.ts\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "harness": "node --import tsx harness/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "probe:tools": "node --import tsx scripts/probe-tools-list.mjs",
    "probe:env-scrub": "node --import tsx scripts/env-scrub-probe.mjs",
    "auth:status": "node --import tsx scripts/auth-status.mjs",
    "phase1:status": "node --import tsx scripts/phase1-status.mjs",
    "check:arms": "node --import tsx scripts/check-arm-config.mjs",
    "check:claude-auth": "node --import tsx scripts/check-claude-auth.mjs",
    "check:run": "node --import tsx scripts/check-run.mjs",
    "check:static": "node --import tsx scripts/check-static.mjs",
    "check:scripts": "node --import tsx scripts/check-script-syntax.mjs",
    "check:hooks": "node --import tsx scripts/check-hooks.mjs",
    "check:completion": "node --import tsx scripts/check-completion.mjs",
    "check:metrics": "node --import tsx scripts/check-metrics.mjs",
    "check:report-generation": "node --import tsx scripts/check-report-generation.mjs",
    "check:completion-report-current": "node --import tsx scripts/check-completion-report-current.mjs",
    "check:completion-writeup-current": "node --import tsx scripts/check-completion-writeup-current.mjs",
    "check:completion-audit-coverage": "node --import tsx scripts/check-completion-audit-coverage.mjs",
    "check:evidence-matrix": "node --import tsx scripts/check-evidence-matrix.mjs",
    "check:docs-runbook": "node --import tsx scripts/check-docs-runbook.mjs",
    "check:phase1-freshness": "node --import tsx scripts/check-phase1-freshness.mjs",
    "check:performance-smoke-audit": "node --import tsx scripts/check-performance-smoke-audit.mjs",
    "check:result-invariants": "node --import tsx scripts/check-result-invariants.mjs",
    "check:run-audit": "node --import tsx scripts/check-run-audit.mjs",
    "check:run-final-plan": "node --import tsx scripts/check-run-final-plan.mjs",
    "check:run-final-resume": "node --import tsx scripts/check-run-final-resume.mjs",
    "check:run-matrix": "node --import tsx scripts/check-run-matrix.mjs",
    "check:static-audit": "node --import tsx scripts/check-static-audit.mjs",
    "check:artifact-sanitization": "node --import tsx scripts/check-artifact-sanitization.mjs",
    "check:secret-patterns": "node --import tsx scripts/check-secret-patterns.mjs",
    "check:security-framing": "node --import tsx scripts/check-security-framing.mjs",
    "check:harness-shape": "node --import tsx scripts/check-harness-shape.mjs",
    "check:provider-config": "node --import tsx scripts/check-provider-config.mjs",
    "check:whitespace": "node --import tsx scripts/check-whitespace.mjs",
    "plan:run": "node --import tsx scripts/print-run-matrix.mjs",
    "run:final": "node --import tsx scripts/run-final.mjs",
    "cleanup:sandbox": "node --import tsx scripts/cleanup-sandbox-repos.mjs",
    "scan:secrets": "node --import tsx scripts/secret-scan.mjs",
    "hooks:install": "node --import tsx scripts/install-pre-push-hook.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "zod": "^4.6.5"
  }
}
