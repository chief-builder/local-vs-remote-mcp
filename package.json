{
  "name": "local-vs-remote-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Research harness comparing local stdio MCP and remote streamable HTTP MCP transports.",
  "type": "module",
  "scripts": {
    "harness": "node --import tsx harness/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "probe:tools": "node scripts/probe-tools-list.mjs",
    "probe:env-scrub": "node scripts/env-scrub-probe.mjs",
    "auth:status": "node scripts/auth-status.mjs",
    "phase1:status": "node scripts/phase1-status.mjs",
    "check:arms": "node --import tsx scripts/check-arm-config.mjs",
    "check:claude-auth": "node scripts/check-claude-auth.mjs",
    "check:run": "node --import tsx scripts/check-run.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:scripts": "node scripts/check-script-syntax.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:completion": "node --import tsx scripts/check-completion.mjs",
    "check:metrics": "node --import tsx scripts/check-metrics.mjs",
    "check:report-generation": "node --import tsx scripts/check-report-generation.mjs",
    "check:completion-report-current": "node scripts/check-completion-report-current.mjs",
    "check:completion-writeup-current": "node scripts/check-completion-writeup-current.mjs",
    "check:completion-audit-coverage": "node scripts/check-completion-audit-coverage.mjs",
    "check:evidence-matrix": "node scripts/check-evidence-matrix.mjs",
    "check:docs-runbook": "node scripts/check-docs-runbook.mjs",
    "check:phase1-freshness": "node scripts/check-phase1-freshness.mjs",
    "check:performance-smoke-audit": "node scripts/check-performance-smoke-audit.mjs",
    "check:result-invariants": "node scripts/check-result-invariants.mjs",
    "check:run-audit": "node --import tsx scripts/check-run-audit.mjs",
    "check:run-final-plan": "node --import tsx scripts/check-run-final-plan.mjs",
    "check:run-final-resume": "node scripts/check-run-final-resume.mjs",
    "check:run-matrix": "node --import tsx scripts/check-run-matrix.mjs",
    "check:static-audit": "node scripts/check-static-audit.mjs",
    "check:artifact-sanitization": "node scripts/check-artifact-sanitization.mjs",
    "check:secret-patterns": "node --import tsx scripts/check-secret-patterns.mjs",
    "check:security-framing": "node --import tsx scripts/check-security-framing.mjs",
    "check:harness-shape": "node scripts/check-harness-shape.mjs",
    "check:provider-config": "node scripts/check-provider-config.mjs",
    "check:whitespace": "node scripts/check-whitespace.mjs",
    "plan:run": "node --import tsx scripts/print-run-matrix.mjs",
    "run:final": "node --import tsx scripts/run-final.mjs",
    "cleanup:sandbox": "node scripts/cleanup-sandbox-repos.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "hooks:install": "node scripts/install-pre-push-hook.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "zod": "^4.4.3"
  }
}
